# Default: normalize line endings to LF in the repo, native on checkout
* text=auto eol=lf

# Source files — always LF
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf

# Jupyter notebooks — treat as text but don't munge JSON
*.ipynb text eol=lf

# Binaries — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.npy binary
*.npz binary
*.parquet binary
*.sqlite binary
*.pkl binary
*.pickle binary
*.bin binary
*.whl binary
